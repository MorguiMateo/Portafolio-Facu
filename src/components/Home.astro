---
import '../styles/global.css';
import SkillTag from './SkillTag.astro';
import ContactModal from './contact-modal.astro';
import { fade } from 'astro:transitions';

const skills = [
	'HTML',
	'CSS',
	'JavaScript',
	'TypeScript',
	'Tailwind',
	'React',
	'Astro',
	'Next.js',
	'Node.js',
	'MongoDB',
	'Shadcn',
	'Scraping',
	'Vercel',
	'ViteJS',
	'Playwright',
];

const slowFade = fade({ duration: 240 });
---
<div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-900 to-gray-800 text-gray-200">
	<div class="max-w-3xl mx-auto px-6 py-10">
		
		<!-- Main -->
		<div class="flex flex-col items-center justify-center mb-12">
			<div class="relative mb-5">
				<img draggable="false" class="w-24 h-24 rounded-full border-3 border-cyan-400 shadow-lg shadow-cyan-400/20" src="https://avatars.githubusercontent.com/u/148649344?v=4" alt="profile picture" />

				<!-- Fondo de la pfp que hace que sea mas bonita con un color transparente sutil-->
				<div class="absolute inset-0 rounded-full bg-gradient-to-t from-cyan-400/10 to-transparent"></div>
			</div>
			<h1 class="text-2xl md:text-4xl font-bold mb-2 bg-gradient-to-r from-gray-100 to-gray-300 bg-clip-text text-transparent">Morgui Mateo</h1>
			<p class="text-base text-gray-400 mb-5">Full-Stack Developer</p>	
			<div class="flex flex-row gap-3">
				<a class="px-3 py-2 text-sm bg-gray-800 hover:bg-gray-700 border border-gray-600 hover:border-cyan-400 rounded-lg transition-all duration-300 text-cyan-400 hover:text-cyan-300 font-medium" href="https://github.com/MorguiMateo">GitHub</a>
				<button id="open-contact-modal" class="px-3 py-2 text-sm bg-cyan-500 hover:bg-cyan-600 rounded-lg transition-all duration-300 text-gray-900 font-medium">Contact</button>
			</div>
		</div>
		<!-- About Me -->

		<section class="mb-12">
			<div class="mb-6">
				<h2 class="text-xl md:text-2xl font-bold mb-3 text-gray-100">About Me</h2>
			</div>
			<div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-5 shadow-xl">
				<!-- El leading-relaxed es igual a line-height: 1.625; -->
				<p class="text-sm text-gray-300 leading-relaxed">
					Hello, I am Mateo Morgui, a full-stack developer with basic knowledge in web development and experience in scraping. I am passionate about technology and always strive to learn and improve my skills.				</p>
			</div>
		</section>

		<!-- Skills -->
		<section class="mb-12">
			<div class="mb-6">
				<h2 class="text-xl md:text-2xl font-bold mb-3 text-gray-100">Skills</h2>
			</div>
			<div class="flex flex-wrap gap-2">
				{skills.map((skill) => (
					<SkillTag label={skill} />
				))}
			</div>
		</section>

		<!-- Projectos -->
		<section class="mb-12">
			<div class="mb-6">
				<h2 class="text-xl md:text-2xl font-bold mb-3 text-gray-100">Projects</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<a
					class="group block hover:scale-[1.01] transition-all duration-300 bg-gray-800/50 border border-gray-700/50 rounded-xl p-5 shadow-xl hover:shadow-2xl hover:border-cyan-400/30"
					href="/projects/kalak"
					transition:animate={slowFade}
				>
					<div
						class="w-full h-32 bg-gradient-to-br from-gray-700 to-gray-800 rounded-lg mb-3 overflow-hidden border border-gray-700/60"
						transition:name="kalak-image"
					>
						<img
							src="/kalak.png"
							alt="Kalak hero: Gato comiendo comida natural frente al CTA de la marca"
							class="w-full h-full object-cover"
							loading="lazy"
						/>
					</div>
					<div class="text-center">
						<h3
							class="text-lg font-semibold text-gray-100 mb-2 group-hover:text-cyan-400 transition-colors duration-300"
							transition:name="kalak-title"
						>
							Kalak Website
						</h3>
						<p
							class="text-xs text-gray-400 leading-relaxed mb-3"
							transition:name="kalak-description"
						>Kalak es una marca de alimentación natural para mascotas que comunica su propuesta con un enfoque cálido y cercano.
						</p>
						<div class="flex justify-center gap-2">
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">Next.js</span>
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">TypeScript</span>
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">Tailwind</span>
						</div>
					</div>
				</a>
				<a
					class="group block hover:scale-[1.01] transition-all duration-300 bg-gray-800/50 backdrop-blur-sm border border-gray-700/50 rounded-xl p-5 shadow-xl hover:shadow-2xl hover:border-cyan-400/30"
					href="/projects/anime"
					transition:animate={slowFade}
				>
					<div
						class="w-full h-32 bg-gradient-to-br from-gray-700 to-gray-800 rounded-lg mb-3 overflow-hidden border border-gray-700/60"
						transition:name="anime-image"
					>
						<img
							src="/Anime.png"
							alt="Captura de AnimeflvClon mostrando listado de episodios"
							class="w-full h-full object-cover"
							loading="lazy"
						/>
					</div>
					<div class="text-center">
						<h3
							class="text-lg font-semibold text-gray-100 mb-2 group-hover:text-cyan-400 transition-colors duration-300"
							transition:name="anime-title"
						>
							AnimeflvClon
						</h3>
						<p
							class="text-xs text-gray-400 leading-relaxed mb-3"
							transition:name="anime-description"
						>
							Página clon construida como práctica para aprender scraping y automatizar la recolección de episodios.
						</p>
						<div class="flex justify-center gap-2">
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">Next.js</span>
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">Playwright</span>
							<span class="px-2 py-1 bg-cyan-500/10 text-cyan-400 text-xs rounded-full border border-cyan-500/20">Tailwind</span>
						</div>
					</div>
				</a>
			</div>
		</section>
	</div>
</div>

<ContactModal />
